              'app/src/main/java/com/studyflow/app/service/StopwatchStateHolder.kt': """package com.studyflow.app.service
          import android.content.Context
          import android.os.SystemClock
          import kotlinx.coroutines.flow.MutableStateFlow
          import kotlinx.coroutines.flow.StateFlow
          import kotlinx.coroutines.flow.asStateFlow
          enum class StopwatchStatus { IDLE, RUNNING, PAUSED }
          data class StopwatchSnapshot(
              val status: StopwatchStatus = StopwatchStatus.IDLE,
              val accumulatedDurationMs: Long = 0L,
              val currentSessionElapsedMs: Long = 0L
          )
          object StopwatchStateHolder {
              private val _snapshot = MutableStateFlow(StopwatchSnapshot())
              val snapshot: StateFlow<StopwatchSnapshot> = _snapshot.asStateFlow()
              private var baseElapsed: Long = 0L
              private var accumulated: Long = 0L
              private var startTimeEpoch: Long = 0L
              fun init(context: Context) {}
              @Synchronized fun start() {
                  if (_snapshot.value.status == StopwatchStatus.RUNNING) return
                  if (_snapshot.value.status == StopwatchStatus.IDLE) {
                      accumulated = 0L
                      startTimeEpoch = System.currentTimeMillis()
                  }
                  baseElapsed = SystemClock.elapsedRealtime()
                  _snapshot.value = StopwatchSnapshot(StopwatchStatus.RUNNING, accumulated, accumulated)
              }
              @Synchronized fun pause() {
                  if (_snapshot.value.status != StopwatchStatus.RUNNING) return
                  accumulated += (SystemClock.elapsedRealtime() - baseElapsed)
                  _snapshot.value = StopwatchSnapshot(StopwatchStatus.PAUSED, accumulated, accumulated)
              }
              @Synchronized fun updateLive() {
                  if (_snapshot.value.status == StopwatchStatus.RUNNING) {
                      val live = accumulated + (SystemClock.elapsedRealtime() - baseElapsed)
                      _snapshot.value = _snapshot.value.copy(currentSessionElapsedMs = live)
                  }
              }
              @Synchronized fun stop(): Triple<Long, Long, Long>? {
                  if (_snapshot.value.status == StopwatchStatus.IDLE) return null
                  if (_snapshot.value.status == StopwatchStatus.RUNNING) {
                      accumulated += (SystemClock.elapsedRealtime() - baseElapsed)
                  }
                  val start = startTimeEpoch
                  val end = System.currentTimeMillis()
                  val total = accumulated / 1000L
                  _snapshot.value = StopwatchSnapshot(StopwatchStatus.IDLE)
                  accumulated = 0L
                  return Triple(start, end, total)
              }
          }
          """,

              'app/src/main/java/com/studyflow/app/service/StopwatchService.kt': """package com.studyflow.app.service
          import android.app.*
          import android.content.Intent
          import android.content.pm.ServiceInfo
          import android.os.Build
          import android.os.IBinder
          import android.os.SystemClock
          import androidx.core.app.NotificationCompat
          import androidx.core.app.ServiceCompat
          import com.studyflow.app.R
          import com.studyflow.app.StudyFlowApplication
          import com.studyflow.app.ui.MainActivity
          import kotlinx.coroutines.*
          class StopwatchService : Service() {
              companion object {
                  const val ACTION_START = "ACTION_START"
                  const val ACTION_PAUSE = "ACTION_PAUSE"
                  const val ACTION_RESUME = "ACTION_RESUME"
                  const val ACTION_STOP = "ACTION_STOP"
                  const val NOTIFICATION_ID = 2001
              }
              private val scope = CoroutineScope(Dispatchers.Main + Job())
              private var tickerJob: Job? = null
              override fun onBind(intent: Intent?): IBinder? = null
              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  when (intent?.action) {
                      ACTION_START, ACTION_RESUME -> {
                          StopwatchStateHolder.start()
                          showNotification()
                          tickerJob?.cancel()
                          tickerJob = scope.launch {
                              while (isActive) {
                                  StopwatchStateHolder.updateLive()
                                  delay(1000)
                              }
                          }
                      }
                      ACTION_PAUSE -> {
                          tickerJob?.cancel()
                          StopwatchStateHolder.pause()
                          showNotification()
                      }
                      ACTION_STOP -> {
                          tickerJob?.cancel()
                          val res = StopwatchStateHolder.stop()
                          if (res != null) {
                              scope.launch(Dispatchers.IO) {
                                  StudyFlowApplication.repository.recordCompletedSession(res.first, res.second, res.third)
                              }
                          }
                          ServiceCompat.stopForeground(this, ServiceCompat.STOP_FOREGROUND_REMOVE)
                          stopSelf()
                      }
                  }
                  return START_STICKY
              }
              private fun showNotification() {
                  val snap = StopwatchStateHolder.snapshot.value
                  val isRunning = snap.status == StopwatchStatus.RUNNING
                  val openIntent = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE)
                  val toggleIntent = PendingIntent.getService(this, 1, Intent(this, StopwatchService::class.java).apply { action = if (isRunning) ACTION_PAUSE else ACTION_RESUME }, PendingIntent.FLAG_IMMUTABLE)
                  val stopIntent = PendingIntent.getService(this, 2, Intent(this, StopwatchService::class.java).apply { action = ACTION_STOP }, PendingIntent.FLAG_IMMUTABLE)
                  val builder = NotificationCompat.Builder(this, StudyFlowApplication.CHANNEL_ID)
                      .setSmallIcon(R.drawable.ic_notification)
                      .setContentTitle("StudyFlow Timer")
                      .setContentIntent(openIntent)
                      .setOngoing(isRunning)
                      .setOnlyAlertOnce(true)
                  if (isRunning) {
                      builder.setUsesChronometer(true)
                      builder.setBase(SystemClock.elapsedRealtime() - snap.accumulatedDurationMs)
                      builder.setContentText("Focusing...")
                      builder.addAction(R.drawable.ic_pause, "PAUSE", toggleIntent)
                  } else {
                      builder.setUsesChronometer(false)
                      val s = snap.accumulatedDurationMs / 1000
                      builder.setContentText("PAUSED (" + (s / 60) + "m " + (s % 60) + "s)")
                      builder.addAction(R.drawable.ic_play, "RESUME", toggleIntent)
                  }
                  builder.addAction(R.drawable.ic_stop, "FINISH", stopIntent)
                  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                      ServiceCompat.startForeground(this, NOTIFICATION_ID, builder.build(), ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
                  } else {
                      startForeground(NOTIFICATION_ID, builder.build())
                  }
              }
              override fun onDestroy() {
                  tickerJob?.cancel()
                  scope.cancel()
                  super.onDestroy()
              }
          }
          """,

