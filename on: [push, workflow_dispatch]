              'app/src/main/java/com/studyflow/app/data/StudyRepository.kt': """package com.studyflow.app.data
          import kotlinx.coroutines.flow.Flow
          import java.time.LocalDate
          import java.time.ZoneId
          class StudyRepository(private val dao: SessionDao) {
              fun getAllSessions(): Flow<List<SessionEntity>> = dao.getAllSessions()
              fun getTodaySessions(): Flow<List<SessionEntity>> = dao.getSessionsForDate(LocalDate.now(ZoneId.systemDefault()).toString())
              fun getTodayTotalDuration(): Flow<Long> = dao.getTotalDurationForDate(LocalDate.now(ZoneId.systemDefault()).toString())
              fun getTodaySessionCount(): Flow<Int> = dao.getSessionCountForDate(LocalDate.now(ZoneId.systemDefault()).toString())
              fun getSessionsForDate(date: String): Flow<List<SessionEntity>> = dao.getSessionsForDate(date)
              suspend fun clearHistory() = dao.clearAll()
              suspend fun recordCompletedSession(startTime: Long, endTime: Long, durationSecs: Long) {
                  if (durationSecs <= 0) return
                  val today = LocalDate.now(ZoneId.systemDefault()).toString()
                  dao.insertSession(SessionEntity(startTimeEpochMs = startTime, endTimeEpochMs = endTime, durationSeconds = durationSecs, dateString = today))
              }
          }
